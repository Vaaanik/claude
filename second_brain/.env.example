# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...

# Ваш Telegram ID (узнать: напишите боту /id или @userinfobot). Несколько — через запятую.
# Бот игнорирует всех остальных — это защита вашего компьютера.
ALLOWED_USER_IDS=123456789

# Папка по умолчанию для тем без /project
DEFAULT_CWD=~/second-brain

# ask — бот спрашивает кнопками перед командами и изменением файлов (рекомендуется)
# auto — Claude делает всё сам, без вопросов
PERMISSIONS=ask

# Модель Claude (пусто — по умолчанию из Claude Code)
CLAUDE_MODEL=

# Распознавание голоса локально: tiny / base / small / medium / large-v3
WHISPER_MODEL=small
WHISPER_LANGUAGE=ru

# Доступ к Claude — один из двух вариантов:
# 1) подписка Pro/Max: токен из команды `claude setup-token`
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# 2) API-ключ из console.anthropic.com (оплата за использование)
# ANTHROPIC_API_KEY=sk-ant-...

# Голос ответов (edge-tts): ru-RU-DmitryNeural (мужской) или ru-RU-SvetlanaNeural (женский)
TTS_VOICE=ru-RU-DmitryNeural

# Часовой пояс для календаря
TIMEZONE=Europe/Kyiv

# Google (Gmail, Календарь, Диск): OAuth-клиент типа «Desktop app» из console.cloud.google.com
# Инструкция — в README, раздел «Подключение Google». После заполнения отправьте боту /google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
